{
  "name": "just-crm-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "dom-helpers": "^5.2.1",
    "react": "^19.2.8",
    "react-big-calendar": "^1.20.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.8",
    "react-funnel-pipeline": "^0.2.0",
    "react-router-dom": "^7.18.6",
    "react-scripts": "^5.0.1",
    "web-vitals": "^2.1.4"
